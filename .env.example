# Copy this file to `.env` before running or building the app:
#   cp .env.example .env
#
# These are Firebase Web SDK config values: public, client-visible
# identifiers (they ship in the JS bundle), NOT secrets. The values below
# are the official bubblemap projects' config; replace them with your own
# Firebase project's config if you are working from a fork. The real
# security boundary is Firestore rules, App Check, and API-key HTTP
# referrer restrictions — never put actual secrets in VITE_* variables.

# Production project (bubblemap-app)
VITE_FIREBASE_API_KEY=AIzaSyAcH2oqXkfT2gJjbgmQeU62GmHy78PXyww
VITE_FIREBASE_AUTH_DOMAIN=bubblemap-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=bubblemap-app
VITE_FIREBASE_STORAGE_BUCKET=bubblemap-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=961385019430
VITE_FIREBASE_APP_ID=1:961385019430:web:d81b367e47eaecfc430ee7
VITE_FIREBASE_MEASUREMENT_ID=G-EYXHSKR3ZV

# Development/testing project (mind-map-testing) — used when MODE !== 'production'
VITE_FIREBASE_API_KEY_DEV=AIzaSyD-oEhhMx9GRPYa1Dn6qhFR_yBV18KOY8Q
VITE_FIREBASE_AUTH_DOMAIN_DEV=mind-map-testing.firebaseapp.com
VITE_FIREBASE_PROJECT_ID_DEV=mind-map-testing
VITE_FIREBASE_STORAGE_BUCKET_DEV=mind-map-testing.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID_DEV=427950169016
VITE_FIREBASE_APP_ID_DEV=1:427950169016:web:ca279979776510972d0d4d
VITE_FIREBASE_MEASUREMENT_ID_DEV=G-GZZRF9XDMM

# App Check (reCAPTCHA v3) site key — public, like everything above. App Check
# only initializes in production builds when this is set (src/firebase/index.tsx).
# CD copies this file verbatim into .env, so the real site key must be committed
# here once the app is registered in Firebase console -> App Check. Do NOT turn
# on App Check enforcement in the console before a build with this key is live.
# VITE_RECAPTCHA_PUBLIC_KEY=
